{
  "name": "agent-intercom",
  "version": "0.2.2",
  "description": "Let Claude Code, Codex CLI and Antigravity (Gemini) message each other, with optional live push into open sessions. A zero-dependency MCP mailbox.",
  "bin": {
    "agent-intercom": "cli.js"
  },
  "main": "server.js",
  "files": [
    "cli.js",
    "server.js",
    "pushd.js",
    "codex-ws.js",
    "agy-register.sh",
    "bridge.sh",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/*.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "codex",
    "antigravity",
    "gemini",
    "agents",
    "multi-agent",
    "messaging"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iambashar/agent-intercom.git"
  },
  "homepage": "https://github.com/iambashar/agent-intercom#readme",
  "bugs": {
    "url": "https://github.com/iambashar/agent-intercom/issues"
  }
}
